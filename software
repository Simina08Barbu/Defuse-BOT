# functii auxiliare - desenare dreptunghi rotunjit
# functie auxiliara care deseneaza un dreptunghi cu colturi rotunjite pe canvas def rrect(cv, x1, y1, x2, y2, r, fill):
# desenam cele 4 colturi rotunjite ca arcuri de cerc cv.create_arc(x1,	y1,	x1+2*r, y1+2*r, start=90, extent=90,
fill=fill, outline=fill)
cv.create_arc(x2-2*r, y1,	x2,	y1+2*r, start=0,	extent=90, fill=fill, outline=fill)
cv.create_arc(x1,	y2-2*r, x1+2*r, y2,	start=180, extent=90, fill=fill, outline=fill)
cv.create_arc(x2-2*r, y2-2*r, x2,	y2,	start=270, extent=90, fill=fill, outline=fill)
# umplem spatiul dintre colturi cu doua dreptunghiuri suprapuse in forma de cruce
cv.create_rectangle(x1+r, y1,	x2-r, y2,	fill=fill, outline=fill) cv.create_rectangle(x1,	y1+r, x2,	y2-r, fill=fill, outline=fill)
# generare buton 3d interactiv
# creaza un widget de tip canvas care simuleaza un buton 3d def btn3d(master, text, cmd, cm, ct, cs,
w=160, h=48, fs=13, tc="#F0FAF0", icon=""):
 

cv = tk.Canvas(master, width=w, height=h,
bg=master.cget("bg"), highlightthickness=0, cursor="hand2")
D = 5 # grosimea efectului de umbra/adancime 3d

# functie interna care redeseneaza butonul in functie de starea lui (apasat sau nu)
def draw(pressed=False):
cv.delete("all") # stergem continutul anterior
yo = 1 if pressed else 0 # offset pe axa y daca butonul e apasat if not pressed:
rrect(cv, 3, D, w-3, h-1, 8, cs) # desenam umbra daca nu e apasat rrect(cv, 1, yo,	w-4, h-D+yo, 8, cm) # culoarea de baza
rrect(cv, 3, yo+2, w-6, (h-D)//2+yo, 6, ct) # reflexia/partea superioara mai deschisa
cv.create_rectangle(1, yo, w-4, h-D+yo, outline=ct, fill="") # contur full = f"{icon} {text}" if icon else text # combinam iconita cu textul # adaugam textul in centrul butonului
cv.create_text((w-3)//2, (h-D)//2+yo+1, text=full,
fill=tc, font=("Consolas", fs, "bold"), anchor="center") draw() # desenam starea initiala
# atasam evenimente de mouse pentru animatia de apasare si executia comenzii cv.bind("<Enter>",	lambda e: draw(False))
cv.bind("<ButtonPress-1>",	lambda e: draw(True)) cv.bind("<ButtonRelease-1>", lambda e: (draw(False), cmd())) cv.bind("<Leave>",	lambda e: draw(False))

# stocam datele configurate intern pentru a putea fi modificate ulterior cv._data = {"text": text, "cm": cm, "ct": ct, "cs": cs,
"w": w, "h": h, "fs": fs, "tc": tc, "icon": icon}
return cv

# functie pentru a actualiza textul sau culorile unui buton 3d deja creat def btn3d_update(cv, text=None, cm=None, ct=None):
d = cv._data
if text: d["text"] = text
if cm:	d["cm"]	= cm
if ct:	d["ct"]	= ct
w, h, D = d["w"], d["h"], 5
cv.delete("all")
rrect(cv, 3, D, w-3, h-1, 8, d["cs"])
rrect(cv, 1, 0, w-4, h-D, 8, d["cm"])
rrect(cv, 3, 2, w-6, (h-D)//2, 6, d["ct"]) cv.create_rectangle(1, 0, w-4, h-D, outline=d["ct"], fill="") full = f"{d['icon']} {d['text']}" if d["icon"] else d["text"] cv.create_text((w-3)//2, (h-D)//2+1, text=full,
fill=d["tc"], font=("Consolas", d["fs"], "bold"),
anchor="center")

