# modifica coordonatele unghiului pentru camera dupa axele x si y def _sv(self, d):
if d=="left":	self.ux = min(200, self.ux+10); self.send(f"X{self.ux}")
elif d=="right": self.ux = max(20, self.ux-10); self.send(f"X{self.ux}")
elif d=="up":	self.uy = max(0,	self.uy-10); self.send(f"Y{self.uy}")
elif d=="down": self.uy = min(150, self.uy+10); self.send(f"Y{self.uy}")
# aduce ambele servo-motoare ale camerei in pozitia mediana implicit def _sv_rst(self):
self.ux, self.uy = 130, 20 self.send("X130"); self.send("Y20")
self._status("camera resetata la pozitia implicita.")

