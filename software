b.create_rectangle(0, 0, W, H, fill=C["bg_dark"], outline=C["border"]) # cream un efect de gradient coloristic in functie de nivelul curent for i in range(f):
ra = i/290
r = int(30+ra*190); g = int(165-ra*110); bl = 30 b.create_line(i, 2, i, H-2, fill=f"#{r:02x}{g:02x}{bl:02x}")
# aplicam conturul iluminat la final
b.create_rectangle(0, 0, W-1, H-1, outline=C["border_glow"], fill="")

